{{$backend.host = options('backend.host')}}
{{$frontend.host = options('frontend.host')}}{{literal}}
//{{RAX}}
import user from "/Module/User.js";
import { version } from "/Module/Priya.js";
import { root } from "/Module/Web.js";
import { navigation } from "/Application/Desktop/Module/Navigation.js"
import { taskbar } from "/Application/Desktop/Module/Taskbar.js"
import { file } from "/Application/Desktop/Module/File.js"

require(
    [
        root() + 'Application/Desktop/Css/Desktop.css?' + version(),
        root() + 'Application/Desktop/Css/Navigation.css?' + version(),
        root() + 'Application/Desktop/Css/Task.Bar.css?' + version()
    ],
    function(){
        //need backend.user.current
        file.data.set({
            "controller" : "{{raw|>object(config('controller'), 'json-line')}}",
            "section.id" : "{{$id}}",
            "route.backend.user.current" : "{{server.url(\"{{/literal}}{{$backend.host}}{{literal}}\")}}User/Current/",
            "route.backend.node.application.desktop.navigation": "{{server.url(\"{{/literal}}{{$backend.host}}{{literal}}\")}}Node/Application.Desktop.Navigation/",
            "route.frontend.node.application.desktop.navigation":"{{server.url(\"{{/literal}}{{$frontend.host}}{{literal}}\")}}Application/Desktop/Navigation/"
        });
        navigation.init("{{$id}}");
    }
);
{{/literal}}